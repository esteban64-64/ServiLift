# Copie este archivo como .env y ajuste sus valores. El .env no se sube a git.

# ── Base de datos (MariaDB de XAMPP o MySQL 8) ──
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=servilift_db

# ── JWT: genere una clave propia ──
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave

# ── Archivos (fotos, firmas, PDF) ──
STORAGE_DIR=storage
MAX_FOTO_MB=15

# ── URL que va en el QR del certificado ──
URL_VERIFICACION=http://localhost:8000/verificar
